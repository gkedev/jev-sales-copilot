# Copy to .env (git-ignored). run.sh sources it. Never commit real keys.
# Get a key at https://console.typesafe.ai/keys
TYPESAFE_API_KEY=ts_your_key_here
# Legacy name also accepted as a fallback:
# JEV_API_KEY=ts_your_key_here

# Optional: tailored "say this" line from a small fast LLM (Claude Haiku 4.5). Without it the app
# shows the hand-written playbook lines only. Jev still picks the move and verifies the generated line.
# ANTHROPIC_API_KEY=sk-ant-your_key_here

# Optional
# PORT=8000
# TYPESAFE_LOG_LEVEL=info
